# ==============================================================================
# JOB TRACK (JT) — PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Note: Copy this file to .env.local (for Next.js) or .env (for FastAPI).
# DO NOT commit real secrets or production keys to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE INTEGRATION (Frontend & Backend)
# ------------------------------------------------------------------------------
# Public Supabase URL (e.g. https://your-project.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_URL=https://your-project.supabase.co

# Public Anon Key (Used by client-side browser SDK)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# Secret Service Role Key (BACKEND ONLY — Never expose to client/browser!)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Secret JWT Secret (BACKEND ONLY — Used to decode/verify Supabase JWT tokens)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ------------------------------------------------------------------------------
# 2. GOOGLE GEMINI AI INTEGRATION (Backend Only)
# ------------------------------------------------------------------------------
# Secret Gemini API Key (BACKEND ONLY — Never expose to client/browser!)
GEMINI_API_KEY=your-gemini-api-key

# ------------------------------------------------------------------------------
# 3. FASTAPI BACKEND CONFIGURATION
# ------------------------------------------------------------------------------
# URL of Python FastAPI backend service (e.g. https://jt-backend.onrender.com or http://127.0.0.1:8000)
PYTHON_BACKEND_URL=http://127.0.0.1:8000

# Backend execution port (default: 8000)
PORT=8000
